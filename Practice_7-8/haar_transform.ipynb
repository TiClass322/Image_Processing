    "def run_length_encoding(matrix):\n",
    "    flat_matrix = matrix.flatten()\n",
    "    if len(flat_matrix) == 0:\n",
    "        return []\n",
    "    \n",
    "    encoded = []\n",
    "    current_val = flat_matrix[0]\n",
    "    count = 1\n",
    "    for val in flat_matrix[1:]:\n",
    "        if val == current_val:\n",
    "            count += 1\n",
    "        else:\n",
    "            encoded.append((current_val, count))\n",
    "            current_val = val\n",
    "            count = 1\n",
    "    encoded.append((current_val, count))\n",
    "    return encoded"
   ]
