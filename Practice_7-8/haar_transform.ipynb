    "def quantize(matrix, num_quants):\n",
    "    min_val, max_val = matrix.min(), matrix.max()\n",
    "    if min_val == max_val:\n",
    "        return matrix.astype(np.int64)\n",
    "    step = (max_val - min_val) / num_quants\n",
    "    quantized_matrix = np.round((matrix - min_val) / step) * step + min_val\n",
    "    return quantized_matrix.astype(np.int64)"
   ]
