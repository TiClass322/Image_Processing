    "def haar_wavelet_transform(matrix):\n",
    "    h, w = matrix.shape\n",
    "    if h % 2 != 0 or w % 2 != 0:\n",
    "        # Изменяем размер до ближайших меньших четных измерений, если они нечетные\n",
    "        matrix = cv2.resize(matrix, (w - w % 2, h - h % 2))\n",
    "    h, w = matrix.shape\n",
    "\n",
    "    # Создаем новую матрицу для преобразованных данных\n",
    "    transformed_matrix = np.zeros_like(matrix, dtype=np.float64)\n",
    "\n",
    "    # Низкочастотная компонента (LL)\n",
    "    transformed_matrix[:h//2, :w//2] = (matrix[::2, ::2] + matrix[1::2, ::2] + matrix[::2, 1::2] + matrix[1::2, 1::2]) / 4\n",
    "\n",
    "    # Высокочастотные компоненты\n",
    "    # LH\n",
    "    transformed_matrix[h//2:, :w//2] = (matrix[::2, ::2] - matrix[1::2, ::2] + matrix[::2, 1::2] - matrix[1::2, 1::2]) / 4\n",
    "    # HL\n",
    "    transformed_matrix[:h//2, w//2:] = (matrix[::2, ::2] + matrix[1::2, ::2] - matrix[::2, 1::2] - matrix[1::2, 1::2]) / 4\n",
    "    # HH\n",
    "    transformed_matrix[h//2:, w//2:] = (matrix[::2, ::2] - matrix[1::2, ::2] - matrix[::2, 1::2] + matrix[1::2, 1::2]) / 4\n",
    "\n",
    "    return transformed_matrix"
   ]
  },
